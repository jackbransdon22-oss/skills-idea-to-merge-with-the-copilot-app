---
// Bookmarks component (scaffold).
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// must run ONLY in the client-side <script> boundary at the bottom of this
// file. Astro runs that script in the browser, never during the build, so
// browser-only APIs are safe there.
//
// You will implement the behavior in Step 3.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only.
  //
  // Helper: Convert a number to base62 string (0-9, a-z, A-Z)
  function toBase62(num) {
    const chars = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';
    if (num === 0) return chars[0];
    let result = '';
    while (num > 0) {
      result = chars[num % 62] + result;
      num = Math.floor(num / 62);
    }
    return result;
  }

  // Generate mona- slug using counter strategy
  function generateSlug() {
    let counter = parseInt(localStorage.getItem('bookmark-counter') || '0', 10);
    counter++;
    localStorage.setItem('bookmark-counter', counter.toString());
    return `mona-${toBase62(counter)}`;
  }

  // Get all bookmarks from localStorage
  function getBookmarks() {
    const stored = localStorage.getItem('bookmarks');
    return stored ? JSON.parse(stored) : [];
  }

  // Save bookmarks to localStorage
  function saveBookmarks(bookmarks) {
    localStorage.setItem('bookmarks', JSON.stringify(bookmarks));
  }

  // Render bookmarks into the list
  function renderBookmarks() {
    const bookmarks = getBookmarks();
    const list = document.getElementById('bookmark-list');
    const emptyState = document.getElementById('empty-state');
    const listHeader = document.getElementById('list-header');

    // Clear existing list
    list.innerHTML = '';

    if (bookmarks.length === 0) {
      emptyState.hidden = false;
      listHeader.hidden = true;
      return;
    }

    emptyState.hidden = true;
    listHeader.hidden = false;

    // Render each bookmark
    bookmarks.forEach((bookmark) => {
      const li = document.createElement('li');
      li.className = 'bookmark';

      const urlLink = document.createElement('a');
      urlLink.className = 'url';
      urlLink.href = bookmark.url;
      urlLink.target = '_blank';
      urlLink.rel = 'noopener noreferrer';
      urlLink.textContent = bookmark.url;

      const slugBadge = document.createElement('span');
      slugBadge.className = 'slug';
      slugBadge.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy';
      copyButton.addEventListener('click', () => {
        navigator.clipboard.writeText(bookmark.slug);
        copyButton.textContent = 'Copied!';
        setTimeout(() => {
          copyButton.textContent = 'Copy';
        }, 2000);
      });

      li.appendChild(urlLink);
      li.appendChild(slugBadge);
      li.appendChild(copyButton);
      list.appendChild(li);
    });
  }

  // Form submit handler
  const form = document.getElementById('add-bookmark');
  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // keep this — stops the page from reloading

    const urlInput = document.getElementById('url');
    const url = urlInput.value.trim();

    // Validate URL
    if (!url) {
      return;
    }

    try {
      new URL(url); // Throws if invalid
    } catch {
      alert('Please enter a valid URL');
      return;
    }

    // Generate slug and save bookmark
    const slug = generateSlug();
    const bookmarks = getBookmarks();
    bookmarks.push({ url, slug });
    saveBookmarks(bookmarks);

    // Clear form and re-render
    urlInput.value = '';
    renderBookmarks();
  });

  // Clear all bookmarks
  const clearButton = document.getElementById('clear-all');
  clearButton?.addEventListener('click', () => {
    if (confirm('Are you sure you want to clear all bookmarks?')) {
      localStorage.removeItem('bookmarks');
      localStorage.removeItem('bookmark-counter');
      renderBookmarks();
    }
  });

  // On page load, render saved bookmarks
  renderBookmarks();
</script>
